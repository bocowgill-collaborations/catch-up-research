; finite ownership-state DAG, complete choices, fixed-player ternary payoff
(set-logic QF_LIA)
(set-option :produce-models true)
(set-option :timeout 30000)
(declare-const bad_3_0_0 Int)
(assert (= bad_3_0_0 (ite (> 1 0) 1 (ite (= 1 0) 0 (- 1)))))
(declare-const bad_3_0_1 Int)
(assert (= bad_3_0_1 (ite (> 1 0) 1 (ite (= 1 0) 0 (- 1)))))
(declare-const bad_2_1_0 Int)
(assert (= bad_2_1_0 (ite (> (- 1) 0) 1 (ite (= (- 1) 0) 0 (- 1)))))
(declare-const bad_2_1_1 Int)
(assert (= bad_2_1_1 (ite (> (- 1) 0) 1 (ite (= (- 1) 0) 0 (- 1)))))
(declare-const bad_1_2_0 Int)
(assert (= bad_1_2_0 (ite (> (- 3) 0) 1 (ite (= (- 3) 0) 0 (- 1)))))
(declare-const bad_1_2_1 Int)
(assert (= bad_1_2_1 (ite (> (- 3) 0) 1 (ite (= (- 3) 0) 0 (- 1)))))
(declare-const bad_0_3_0 Int)
(assert (= bad_0_3_0 (ite (> (- 5) 0) 1 (ite (= (- 5) 0) 0 (- 1)))))
(declare-const bad_0_3_1 Int)
(assert (= bad_0_3_1 (ite (> (- 5) 0) 1 (ite (= (- 5) 0) 0 (- 1)))))
(declare-const bad_2_0_0 Int)
(assert (= bad_2_0_0 (ite (or (= bad_3_0_1 1)) 1 (ite (or (= bad_3_0_1 0)) 0 (- 1)))))
(declare-const bad_2_0_1 Int)
(assert (= bad_2_0_1 (ite (or (= bad_2_1_0 (- 1))) (- 1) (ite (or (= bad_2_1_0 0)) 0 1))))
(declare-const bad_0_2_0 Int)
(assert (= bad_0_2_0 (ite (or (= bad_1_2_1 1)) 1 (ite (or (= bad_1_2_1 0)) 0 (- 1)))))
(declare-const bad_0_2_1 Int)
(assert (= bad_0_2_1 (ite (or (= bad_0_3_0 (- 1))) (- 1) (ite (or (= bad_0_3_0 0)) 0 1))))
(declare-const bad_1_0_0 Int)
(assert (= bad_1_0_0 (ite (or (= bad_3_0_1 1)) 1 (ite (or (= bad_3_0_1 0)) 0 (- 1)))))
(declare-const bad_1_0_1 Int)
(assert (= bad_1_0_1 (ite (or (= bad_1_2_0 (- 1))) (- 1) (ite (or (= bad_1_2_0 0)) 0 1))))
(declare-const bad_0_1_0 Int)
(assert (= bad_0_1_0 (ite (or (= bad_2_1_1 1)) 1 (ite (or (= bad_2_1_1 0)) 0 (- 1)))))
(declare-const bad_0_1_1 Int)
(assert (= bad_0_1_1 (ite (or (= bad_0_3_0 (- 1))) (- 1) (ite (or (= bad_0_3_0 0)) 0 1))))
(declare-const bad_0_0_0 Int)
(assert (= bad_0_0_0 (ite (or (= bad_1_0_1 1) (= bad_2_0_1 1)) 1 (ite (or (= bad_1_0_1 0) (= bad_2_0_1 0)) 0 (- 1)))))
(declare-const bad_0_0_1 Int)
(assert (= bad_0_0_1 (ite (or (= bad_0_1_0 (- 1)) (= bad_0_2_0 (- 1))) (- 1) (ite (or (= bad_0_1_0 0) (= bad_0_2_0 0)) 0 1))))
(assert (= bad_0_0_0 1))
(check-sat)
(get-info :all-statistics)
(exit)
