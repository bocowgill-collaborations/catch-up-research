theorem rows : LocalCertificate.TM1Rows SharedModel.machine
    (TM1Normalize.tr stackMachine) decode := by
  intro state
  exact (allRows_lookup SharedModel.entries checked state.val).meaning

/-- The binary block compiler may share every continuation's head-independent jump. -/
theorem allHeadFree (state : SharedModel.Label) : Block.AllHeadFree (SharedModel.machine state) :=
  (allRows_lookup SharedModel.entries checked state.val).headFree

theorem onePrimitive (state : SharedModel.Label) :
    TM1Normalize.OnePrimitive (SharedModel.machine state) :=
  (allRows_lookup SharedModel.entries checked state.val).onePrimitive

theorem supports : TM1.Supports SharedModel.machine Finset.univ := by
  refine ⟨Finset.mem_univ _, fun state _ ↦ ?_⟩
  generalize SharedModel.machine state = stmt
  induction stmt <;> simp_all [TM1.SupportsStmt]

def decodeCfg (cfg : TM1.Cfg SharedModel.Symbol SharedModel.Label SharedModel.Store) :
    TM1.Cfg SharedModel.Symbol SourceLabel SharedModel.Store := TM1Number.mapCfg decode cfg

theorem step_decode (cfg : TM1.Cfg SharedModel.Symbol SharedModel.Label SharedModel.Store) :
    (TM1.step SharedModel.machine cfg).map decodeCfg =
      TM1.step (TM1Normalize.tr stackMachine) (decodeCfg cfg) :=
  LocalCertificate.tm1_step_decode _ _ decode rows cfg

theorem dom_cfg (cfg : TM1.Cfg SharedModel.Symbol SharedModel.Label SharedModel.Store) :
    (StateTransition.eval (TM1.step SharedModel.machine) cfg).Dom ↔
      (StateTransition.eval (TM1.step (TM1Normalize.tr stackMachine)) (decodeCfg cfg)).Dom :=
  (tr_eval_dom (LocalCertificate.tm1_respects _ _ decode rows) rfl).symm

theorem initial : decode (0 : SharedModel.Label) = (default : SourceLabel) := rfl

/-- Exact shared normalization semantics on every finite shared-tape input. -/
theorem eval_dom (input : List SharedModel.Symbol) :
    (TM1.eval SharedModel.machine input).Dom ↔ (TM1.eval stackMachine input).Dom :=
  (LocalCertificate.tm1_halts_iff SharedModel.machine (TM1Normalize.tr stackMachine)
    decode rows initial input).trans (TM1Normalize.tr_eval_dom stackMachine input)

/-- Both termination directions from the actual TM2 emulator input. -/
theorem stack_eval_dom (inputStack : K') (input : List Γ') :
    (TM1.eval SharedModel.machine (TM2to1.trInit inputStack input)).Dom ↔
      (TM2.eval RuntimeModel.machine inputStack input).Dom :=
  (eval_dom _).trans (TM2to1.tr_eval_dom RuntimeModel.machine inputStack input)

/-- Complete connection through the independently certified literal Runtime snapshot. -/
theorem runtime_eval_dom (inputStack : K') (input : List Γ') :
    letI : Inhabited Λ' := ⟨Runtime.label .start⟩
    (TM1.eval SharedModel.machine (TM2to1.trInit inputStack input)).Dom ↔
      (TM2.eval Runtime.machine inputStack input).Dom :=
  (stack_eval_dom inputStack input).trans (RuntimeCertificate.eval_dom inputStack input)

