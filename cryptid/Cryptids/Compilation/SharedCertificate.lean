module

public import Cryptids.Compilation.SharedModel
public import Cryptids.Compilation.LocalCertificate
public import Cryptids.Compilation.Normalize
public import Cryptids.Compilation.Block
public import Cryptids.Compilation.RuntimeCertificate

/-! # Complete local certification of finite normalized shared control -/

@[expose] public section
namespace ConjectureMachines.Compilation.SharedCertificate
open Turing PartrecToTM2 StateTransition

set_option maxRecDepth 16384

def stackMachine := TM2to1.tr RuntimeModel.machine
abbrev SourceLabel := TM1Normalize.Label stackMachine

def decode : SharedModel.Label → SourceLabel := SharedModel.decode

/-- The certificate retains primitive fields and decodes every numeric successor. -/
structure Row (entry : SharedModel.Stmt × SharedModel.RawStmt) : Prop where
  meaning : TM1Number.mapStmt decode entry.1 = TM1Normalize.tr stackMachine entry.2
  headFree : Block.AllHeadFree entry.1
  onePrimitive : TM1Normalize.OnePrimitive entry.1

theorem halt_row : Row (.halt, .halt) := ⟨rfl, trivial, trivial⟩

/-- Structural coverage checks every literal leaf, including duplicates and unused rows. -/
def AllRows : Balanced.RowTree (SharedModel.Stmt × SharedModel.RawStmt) → Prop
  | .empty => True
  | .leaf entry => Row entry
  | .branch _ left right => AllRows left ∧ AllRows right

theorem allRows_lookup
    (tree : Balanced.RowTree (SharedModel.Stmt × SharedModel.RawStmt))
    (checked : AllRows tree) (i : Nat) : Row (tree.lookup i (.halt, .halt)) := by
  induction tree generalizing i with
  | empty => exact halt_row
  | leaf entry =>
    change Row entry at checked
    by_cases h : i = 0
    · simpa only [Balanced.RowTree.lookup, h, ↓reduceIte] using checked
    · simp only [Balanced.RowTree.lookup, h, ↓reduceIte]
      exact halt_row
  | branch count left right ihl ihr =>
    obtain ⟨hl, hr⟩ := checked
    by_cases h : i < count
    · simpa only [Balanced.RowTree.lookup, h, ↓reduceIte] using ihl hl i
    · simpa only [Balanced.RowTree.lookup, h, ↓reduceIte] using ihr hr (i - count)


/-- A named decoder equation can be reused under every primitive constructor. -/
theorem goto_eq (i : SharedModel.Label) (q : SharedModel.RawStmt) (h : decode i = q) :
    TM1Number.mapStmt decode
      (.goto (fun (_ : SharedModel.Symbol) (_ : SharedModel.Store) ↦ i)) =
      TM1.Stmt.goto (fun _ _ ↦ q) :=
  congrArg TM1.Stmt.goto (funext fun _ ↦ funext fun _ ↦ h)

theorem move_meaning (d : Dir) (i : SharedModel.Label) (q : SharedModel.RawStmt)
    (h : decode i = q) :
    TM1Number.mapStmt decode (.move d (.goto (fun _ _ ↦ i))) =
      TM1Normalize.tr stackMachine (.move d q) :=
  congrArg (TM1.Stmt.move d) (goto_eq i q h)

theorem write_meaning (f : SharedModel.Symbol → SharedModel.Store → SharedModel.Symbol)
    (i : SharedModel.Label) (q : SharedModel.RawStmt) (h : decode i = q) :
    TM1Number.mapStmt decode (.write f (.goto (fun _ _ ↦ i))) =
      TM1Normalize.tr stackMachine (.write f q) :=
  congrArg (TM1.Stmt.write f) (goto_eq i q h)

theorem load_meaning (f : SharedModel.Symbol → SharedModel.Store → SharedModel.Store)
    (i : SharedModel.Label) (q : SharedModel.RawStmt) (h : decode i = q) :
    TM1Number.mapStmt decode (.load f (.goto (fun _ _ ↦ i))) =
      TM1Normalize.tr stackMachine (.load f q) :=
  congrArg (TM1.Stmt.load f) (goto_eq i q h)

theorem branch_meaning (p : SharedModel.Symbol → SharedModel.Store → Bool)
    (i j : SharedModel.Label) (q r : SharedModel.RawStmt) (hi : decode i = q) (hj : decode j = r) :
    TM1Number.mapStmt decode (.branch p (.goto (fun _ _ ↦ i)) (.goto (fun _ _ ↦ j))) =
      TM1Normalize.tr stackMachine (.branch p q r) :=
  congrArg₂ (TM1.Stmt.branch p) (goto_eq i q hi) (goto_eq j r hj)

