module

public import Cryptids.Chess.Compilation.Evaluator
public import Cryptids.Chess.Compilation.Encoding
public import Cryptids.Compilation.NatCode

/-! # The explicit non-draw halting postlude

This module supplies the concrete divergent draw branch. `finish_eval` is a compositional
theorem with an explicit source refinement hypothesis. The fully instantiated chess source
and its unconditional refinement are provided by `Chess.Compilation.Source`.
-/

@[expose] public section

namespace Chess.Compilation.Program

open Turing.ToPartrec
open ConjectureMachines.Compilation

set_option backward.isDefEq.respectTransparency false

attribute [-simp] Part.bind_eq_bind Part.map_eq_map Part.pure_eq_some

/-- A finite list literal, generated by the program rather than supplied on its input tape. -/
def literalWords (words : List Nat) : Code := NatCode.tuple (words.map NatCode.literal)

theorem literalWords_eval (words v : List Nat) :
    (literalWords words).eval v = pure words := by
  induction words with
  | nil => simp [literalWords, NatCode.tuple]
  | cons word words ih =>
    change (Code.cons (NatCode.literal word) (literalWords words)).eval v = pure (word :: words)
    simp [ih, Bind.bind]

/-- The full standard position and empty history are encoded in this finite program. -/
def initialData : Code := literalWords Data.initialGameWords

theorem initialData_eval (v : List Nat) :
    initialData.eval v = pure (Data.encodeGame Adjudication.Game.initial) := by
  simpa only [initialData, Data.encode_initialGame] using
    literalWords_eval Data.initialGameWords v

/-- Draw is zero, and either winner is positive. -/
def encodeOutcome : Outcome → Nat
  | .draw => 0
  | .win .white => 1
  | .win .black => 2

/-- An actual recursive Code program which repeats its input forever. -/
def spinBody : Code := .cons (NatCode.literal 1) .id

def spin : Code := .fix spinBody

@[simp] theorem spinBody_eval (v : List Nat) : spinBody.eval v = pure (1 :: v) := by
  simp [spinBody, Bind.bind]

/-- The positive continuation tag never reaches a return, on any input. -/
theorem spin_eval (v : List Nat) : spin.eval v = Part.none := by
  apply Part.eq_none_iff.mpr
  intro out present
  change out ∈ PFun.fix
    (fun w ↦ (spinBody.eval w).map fun x ↦
      if x.headI = 0 then Sum.inl x.tail else Sum.inr x.tail) v at present
  refine PFun.fixInduction (C := fun _ ↦ False) present ?_
  intro words _ ih
  apply ih words
  simp

/-- Return on either positive outcome tag; enter `spin` on the draw tag. -/
def nonDraw : Code := .case spin .nil

theorem nonDraw_eval (outcome : Outcome) :
    nonDraw.eval [encodeOutcome outcome] =
      if outcome = .draw then Part.none else pure [] := by
  cases outcome with
  | draw => simp [nonDraw, encodeOutcome, spin_eval]
  | win color =>
    cases color <;> simp [nonDraw, encodeOutcome]
    rfl

/-- Put the halting postlude after a concrete evaluator program. -/
def finish (evaluator : Code) : Code := .comp nonDraw evaluator

/-- A checked evaluator's output gives exactly the desired non-draw halting behavior. -/
theorem finish_eval (evaluator : Code) (v : List Nat) (outcome : Outcome)
    (refinement : evaluator.eval v = pure [encodeOutcome outcome]) :
    (finish evaluator).eval v = if outcome = .draw then Part.none else pure [] := by
  simpa [finish, refinement, Bind.bind] using nonDraw_eval outcome

theorem finish_dom (evaluator : Code) (v : List Nat) (outcome : Outcome)
    (refinement : evaluator.eval v = pure [encodeOutcome outcome]) :
    ((finish evaluator).eval v).Dom ↔ outcome ≠ .draw := by
  rw [finish_eval evaluator v outcome refinement]
  split_ifs <;> simp_all

end Chess.Compilation.Program
