import CatchUp.Machine.Cases.Prototype

/-! Source composition uses existing literal-generated calls, with no new opcode.
Only successful source computations are simulated by the generic callee contract;
there is no totality assumption and no claimed reverse whole-source simulation. -/
namespace CatchUp.Machine.Comp
open Turing ConjectureMachines Compilation Cases
set_option backward.isDefEq.respectTransparency false

abbrev Code := Turing.ToPartrec.Code

theorem comp_mem_iff (f g : Code) (source result : List Nat) :
    result ∈ (.comp f g : Code).eval source ↔
      ∃ middle ∈ g.eval source, result ∈ f.eval middle := by
  exact Part.mem_bind_iff

theorem comp_dom_iff (f g : Code) (source : List Nat) :
    ((.comp f g : Code).eval source).Dom ↔
      ∃ middle ∈ g.eval source, (f.eval middle).Dom := by
  simp only [Part.dom_iff_mem,comp_mem_iff]
  constructor
  · rintro ⟨result,middle,hg,hf⟩
    exact ⟨middle,hg,result,hf⟩
  · rintro ⟨middle,hg,result,hf⟩
    exact ⟨result,middle,hg,hf⟩

/-- All operands are generated by the two actual pushes. The selected callee
has an explicit finite run, and the saved continuation is actually returned. -/
def invokeCost (source result frames : List Nat) (target continuation steps : Nat) :=
  literalCost (Words.encode source.reverse) target+
    (literalCost (Words.encode (source.reverse++[target])) continuation+
      (callCost source.reverse frames target continuation+steps+
        returnCost result.reverse frames continuation))

theorem invoke (p : Program) (first second callSite target continuation : Nat)
    (hfirst : p[first]?=some (.push target second))
    (hsecond : p[second]?=some (.push continuation callSite))
    (hcall : p[callSite]?=some .call) (source result frames : List Nat) (steps : Nat)
    (callee : run p steps ⟨entry p target,sourceBanks source (frames++[continuation])⟩=
      some ⟨wordState p (Words.start true false),
        sourceBanks result (frames++[continuation])⟩) :
    run p (invokeCost source result frames target continuation steps)
      ⟨entry p first,sourceBanks source frames⟩=
      some ⟨entry p continuation,sourceBanks result frames⟩ := by
  have a := literal_push_nat p first target second hfirst source.reverse frames
  have b := literal_push_nat p second continuation callSite hsecond
    (source.reverse++[target]) frames
  simp only [List.append_assoc,List.cons_append,List.nil_append] at b
  rw [invokeCost,run_add]
  change (run p _ ⟨entry p first,Words.natBanks source.reverse frames⟩).bind _=_
  rw [a,Option.bind_some,run_add,b,Option.bind_some,entry_call p callSite hcall]
  exact call_callee_return p source.reverse result.reverse frames target continuation steps callee

/-- Six instructions implement composition. The two call sites may be shared;
all labels are ordinary runtime addresses, with no width bound. -/
structure Layout (p : Program) where
  first : Nat
  secondG : Nat
  callG : Nat
  resume : Nat
  secondF : Nat
  callF : Nat
  done : Nat
  targetF : Nat
  targetG : Nat
  first_op : p[first]?=some (.push targetG secondG)
  secondG_op : p[secondG]?=some (.push resume callG)
  callG_op : p[callG]?=some .call
  resume_op : p[resume]?=some (.push targetF secondF)
  secondF_op : p[secondF]?=some (.push done callF)
  callF_op : p[callF]?=some .call

def composeCost (p : Program) (layout : Layout p) (source middle result frames : List Nat)
    (gSteps fSteps : Nat) :=
  invokeCost source middle frames layout.targetG layout.resume gSteps+
    invokeCost middle result frames layout.targetF layout.done fSteps

theorem compose_run (p : Program) (layout : Layout p)
    (source middle result frames : List Nat) (gSteps fSteps : Nat)
    (hg : run p gSteps
      ⟨entry p layout.targetG,sourceBanks source (frames++[layout.resume])⟩=
      some ⟨wordState p (Words.start true false),
        sourceBanks middle (frames++[layout.resume])⟩)
    (hf : run p fSteps
      ⟨entry p layout.targetF,sourceBanks middle (frames++[layout.done])⟩=
      some ⟨wordState p (Words.start true false),
        sourceBanks result (frames++[layout.done])⟩) :
    run p (composeCost p layout source middle result frames gSteps fSteps)
      ⟨entry p layout.first,sourceBanks source frames⟩=
      some ⟨entry p layout.done,sourceBanks result frames⟩ := by
  rw [composeCost,run_add,
    invoke p layout.first layout.secondG layout.callG layout.targetG layout.resume
      layout.first_op layout.secondG_op layout.callG_op source middle frames gSteps hg,
    Option.bind_some,
    invoke p layout.resume layout.secondF layout.callF layout.targetF layout.done
      layout.resume_op layout.secondF_op layout.callF_op middle result frames fSteps hf]

/-- A callee realizes every successful source result for every earlier frame
list. This is a forward simulation contract, explicitly not a reverse theorem. -/
def ResultContract (p : Program) (code : Code) (address : Nat) : Prop :=
  ∀ source result frames, result ∈ code.eval source →
    ∃ steps, run p steps ⟨entry p address,sourceBanks source frames⟩=
      some ⟨wordState p (Words.start true false),sourceBanks result frames⟩

theorem comp_result_contract (p : Program) (layout : Layout p) (f g : Code)
    (hdone : p[layout.done]?=some .ret)
    (hf : ResultContract p f layout.targetF) (hg : ResultContract p g layout.targetG) :
    ResultContract p (.comp f g) layout.first := by
  intro source result frames h
  obtain ⟨middle,hgsource,hfsource⟩ := (comp_mem_iff f g source result).mp h
  obtain ⟨gSteps,hgrun⟩ := hg source middle (frames++[layout.resume]) hgsource
  obtain ⟨fSteps,hfrun⟩ := hf middle result (frames++[layout.done]) hfsource
  refine ⟨composeCost p layout source middle result frames gSteps fSteps,?_⟩
  rw [←entry_return p layout.done hdone]
  exact compose_run p layout source middle result frames gSteps fSteps hgrun hfrun

/-- Partial-program source correctness and the concrete continuation run. No
source or machine premise is required for inputs outside the source domain. -/
theorem comp_correct (p : Program) (layout : Layout p) (f g : Code)
    (hf : ResultContract p f layout.targetF) (hg : ResultContract p g layout.targetG)
    (source result frames : List Nat) (h : result ∈ (.comp f g : Code).eval source) :
    ∃ middle gSteps fSteps, middle ∈ g.eval source ∧ result ∈ f.eval middle ∧
      run p (composeCost p layout source middle result frames gSteps fSteps)
        ⟨entry p layout.first,sourceBanks source frames⟩=
        some ⟨entry p layout.done,sourceBanks result frames⟩ := by
  obtain ⟨middle,hgsource,hfsource⟩ := (comp_mem_iff f g source result).mp h
  obtain ⟨gSteps,hgrun⟩ := hg source middle (frames++[layout.resume]) hgsource
  obtain ⟨fSteps,hfrun⟩ := hf middle result (frames++[layout.done]) hfsource
  exact ⟨middle,gSteps,fSteps,hgsource,hfsource,
    compose_run p layout source middle result frames gSteps fSteps hgrun hfrun⟩

theorem comp_undefined_inner (f g : Code) (source : List Nat)
    (h : ¬(g.eval source).Dom) : ¬((.comp f g : Code).eval source).Dom := by
  intro hd
  obtain ⟨middle,hg,_⟩ := (comp_dom_iff f g source).mp hd
  exact h (Part.dom_iff_mem.mpr ⟨middle,hg⟩)

theorem comp_undefined_outer (f g : Code) (source : List Nat)
    (h : ∀ middle ∈ g.eval source, ¬(f.eval middle).Dom) :
    ¬((.comp f g : Code).eval source).Dom := by
  intro hd
  obtain ⟨middle,hg,hf⟩ := (comp_dom_iff f g source).mp hd
  exact h middle hg hf

/-- Generic blank-tape initialization, with no callee code or continuation data
preloaded. The partial source result is the only termination premise. -/
theorem comp_blank (p : Program) (layout : Layout p) (f g : Code)
    (hfirst : layout.first=0)
    (hf : ResultContract p f layout.targetF) (hg : ResultContract p g layout.targetG)
    (source result : List Nat) (h : result ∈ (.comp f g : Code).eval source) :
    ∃ steps, FlatInit.runFrom (generated p source.reverse).toMachine steps
      ConjectureMachines.init=some (embed p source.reverse
        ⟨entry p layout.done,sourceBanks result []⟩) := by
  obtain ⟨middle,gSteps,fSteps,_,_,hrun⟩ := comp_correct p layout f g hf hg source result [] h
  rw [hfirst] at hrun
  refine ⟨(4+4*(Words.encode source.reverse).length)+
    (2+composeCost p layout source middle result [] gSteps fSteps),?_⟩
  rw [full_add,initializes,Option.bind_some,run_embed]
  rw [run_add,boot,Option.bind_some]
  simpa only [sourceBanks,Option.map_some] using
    congrArg (Option.map (embed p source.reverse)) hrun

theorem comp_blank_halts (p : Program) (layout : Layout p) (f g : Code)
    (hfirst : layout.first=0) (hdone : p[layout.done]?=some .halt)
    (hf : ResultContract p f layout.targetF) (hg : ResultContract p g layout.targetG)
    (source : List Nat) (h : ((.comp f g : Code).eval source).Dom) :
    Halts (generated p source.reverse).toMachine := by
  obtain ⟨result,hresult⟩ := Part.dom_iff_mem.mp h
  obtain ⟨steps,hrun⟩ := comp_blank p layout f g hfirst hf hg source result hresult
  have hstop : step (generated p source.reverse).toMachine (embed p source.reverse
      ⟨entry p layout.done,sourceBanks result []⟩)=none := by
    rw [step_embed,terminal p _ layout.done (Or.inr hdone)]
    rfl
  exact Part.dom_iff_mem.mpr ⟨_,StateTransition.mem_eval.mpr
    ⟨FlatInit.runFrom_reaches _ _ _ _ hrun,hstop⟩⟩

end CatchUp.Machine.Comp
